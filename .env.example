# SPICE MCP client - environment template.
#
#   copy .env.example .env
#
# `.env` is git-ignored; this file is not, so never put real credentials here.
#
# The LLM is Claude on AWS Bedrock. Bedrock auth is IAM-based, so there is no key for
# this app to hold: the AWS SDK resolves credentials itself from the standard chain, and
# nothing credential-shaped is ever stored in the app's config or written to a log.
# Everything below is optional - if your credentials already resolve (you have run
# `aws configure`, or you are on an instance role), you can copy this file unchanged.

# The Bedrock inference profile to talk to. This is a profile id, not a display name;
# the `us.` prefix is required for cross-region-inference models. Note that `us.` is
# billed at a 10% premium over `global.` - switch to `global.anthropic.claude-opus-5` if
# you do not need US-only routing. List what your account has with
# `python scripts\list_bedrock_models.py`.
SPICE_MCP_MODEL=us.anthropic.claude-opus-5

# Inference profile availability is region-scoped, so this has to be right. Falls back to
# AWS_REGION / AWS_DEFAULT_REGION, then to us-east-1.
SPICE_MCP_AWS_REGION=us-east-1

# --- AWS credentials: pick whichever style your account uses, or none -----------------
#
# The default chain finds all of these without any help from this app, in this order.
# Set them in the real environment if you prefer; .env is just a convenience.
#
# 1. Static or temporary IAM keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# 2. A named profile from ~/.aws/credentials.
# AWS_PROFILE=default
#
# 3. A Bedrock bearer token, if your organisation issued one instead of IAM credentials.
# AWS_BEARER_TOKEN_BEDROCK=

# Where per-session token logs are written. Relative paths are resolved from the
# repo root. The default is git-ignored.
# SPICE_MCP_SESSIONS_DIR=sessions

# Override LTspice's location if it is not at the per-user install path
# %LOCALAPPDATA%\Programs\ADI\LTspice\LTspice.exe.
# LTSPICE_EXE=

# DEBUG, INFO, WARNING. Server diagnostics go to stderr; stdout is the MCP wire.
# SPICE_MCP_LOG_LEVEL=INFO
