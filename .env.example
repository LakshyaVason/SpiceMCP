# SPICE MCP client - environment template.
#
#   copy .env.example .env
#
# Then fill in TAMU_API_KEY below. `.env` is git-ignored; this file is not, so
# never put a real key here.

# Required. Your TAMU AI Chat key. The app reads it from here or from the
# environment, and never logs it - only a length and the last four characters.
TAMU_API_KEY=

# The model to talk to. Must support tool calling; check yours with
# `python scripts\probe_tool_calling.py`. Ids from this proxy can contain
# spaces, which is normal - do not quote or strip them.
SPICE_MCP_MODEL=protected.Claude Opus 4.8

# The OpenAI-compatible endpoint. Note there is no `/v1` segment: adding one
# gets a 403 "Direct API passthrough is disabled."
SPICE_MCP_BASE_URL=https://chat-api.tamu.ai/openai

# Where per-session token logs are written. Relative paths are resolved from the
# repo root. The default is git-ignored.
# SPICE_MCP_SESSIONS_DIR=sessions

# Override LTspice's location if it is not at the per-user install path
# %LOCALAPPDATA%\Programs\ADI\LTspice\LTspice.exe.
# LTSPICE_EXE=

# DEBUG, INFO, WARNING. Server diagnostics go to stderr; stdout is the MCP wire.
# SPICE_MCP_LOG_LEVEL=INFO
