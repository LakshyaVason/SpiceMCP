# SPICE MCP client - environment template.
#
#   copy .env.example .env
#
# Then fill in TAMU_API_KEY below. `.env` is git-ignored; this file is not, so
# never put a real key here.

# Required. Your TAMU AI Chat key. The app reads it from here or from the
# environment, and never logs it - only a length and the last four characters.
TAMU_API_KEY=

# The model to talk to. Must be able to call tools one way or the other; check
# yours with `python scripts\probe_tool_calling.py`. Ids from this proxy can
# contain spaces, which is normal - do not quote or strip them.
SPICE_MCP_MODEL=protected.Claude Opus 4.8

# How tools are driven. Two modes, because not every route on this proxy can do
# the first one:
#
#   native        the OpenAI `tools` array; the model replies with
#                 `message.tool_calls`. The default.
#   prompted_json the tool catalogue goes in the system prompt instead and the
#                 model replies with one JSON object per turn. For routes that
#                 accept `tools` and then answer as though they had none.
#
# `protected.Claude Opus 4.8` works in native mode. `us.anthropic.claude-opus-5`
# needs prompted_json - it accepts `tools` and ignores it, so in native mode it
# says it cannot see your files and no tool is ever called. Other
# `us.anthropic.*` ids have not been checked; probe the one you pick.
# SPICE_MCP_TOOL_MODE=native

# The TAMU Gateway host. OpenAI-compatible paths live under /v1.
SPICE_MCP_BASE_URL=https://gateway.api.tamu.ai

# Where per-session token logs are written. Relative paths are resolved from the
# repo root. The default is git-ignored.
# SPICE_MCP_SESSIONS_DIR=sessions

# Override LTspice's location if it is not at the per-user install path
# %LOCALAPPDATA%\Programs\ADI\LTspice\LTspice.exe.
# LTSPICE_EXE=

# DEBUG, INFO, WARNING. Server diagnostics go to stderr; stdout is the MCP wire.
# SPICE_MCP_LOG_LEVEL=INFO
